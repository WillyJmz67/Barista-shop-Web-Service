# Copia como .env para desarrollo local. En Vercel define estas mismas keys en
# Project > Settings > Environment Variables.
FLASK_SECRET_KEY=pon-aqui-una-clave-secreta-larga-y-aleatoria
ADMIN_PASSWORD=pon-una-contrasena-segura
WHATSAPP_NUMBER=573173169936
SHOP_NAME=Café & Barista
SHOP_LOCATION=Villavicencio, Colombia

# Opcional: MercadoPago (sin esto, el checkout usa WhatsApp)
MP_ACCESS_TOKEN=

# ── Base de datos ──
# Local (por defecto si no defines nada): SQLite
# DATABASE_URL=sqlite:///tienda.db
#
# Supabase (producción en Vercel). Usa la Connection String del dashboard:
# Supabase > Project Settings > Database > Connection string > URI
# Recomendado: usar el pooler (puerto 6543) con ?pgbouncer=true para serverless.
# Ejemplo pooler:
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Ejemplo directa (solo para seed/migraciones, puerto 5432):
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_REF.supabase.co:5432/postgres?sslmode=require
